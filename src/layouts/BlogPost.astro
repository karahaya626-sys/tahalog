---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<html lang="ja">
	<head>
		<BaseHead title={title} description={description} />
	</head>

	<body>
		<Header />

		<main>
			<article>
				<header class="article-header">
					<p class="log-label">// log entry</p>

					<div class="date">
						<FormattedDate date={pubDate} />

						{
							updatedDate && (
								<span class="updated">
									/ updated <FormattedDate date={updatedDate} />
								</span>
							)
						}
					</div>

					<h1>{title}</h1>

					<p class="description">{description}</p>
				</header>

				{
					heroImage && (
						<div class="hero-image">
							<Image
								width={1200}
								height={630}
								src={heroImage}
								alt=""
							/>
						</div>
					)
				}

				<div class="prose">
					<slot />
				</div>

				<div class="back">
					<a href="/blog">← back to logs</a>
				</div>
			</article>
		</main>

		<Footer />
	</body>
</html>

<style>
	main {
		width: min(900px, calc(100% - 2rem));
		margin: 0 auto;
		padding: 6rem 0;
	}

	.article-header {
		max-width: 760px;
		margin-bottom: 3rem;
	}

	.log-label {
		margin: 0 0 1rem;
		font-family: monospace;
		font-size: 0.85rem;
		opacity: 0.45;
	}

	.date {
		font-family: monospace;
		font-size: 0.8rem;
		opacity: 0.5;
	}

	.updated {
		margin-left: 0.5rem;
	}

	h1 {
		margin: 1rem 0 1.5rem;
		font-size: clamp(2.2rem, 6vw, 4.2rem);
		line-height: 1.15;
		letter-spacing: -0.04em;
	}

	.description {
		max-width: 650px;
		margin: 0;
		font-size: 1.05rem;
		line-height: 1.8;
		opacity: 0.65;
	}

	.hero-image {
		margin: 3rem 0 4rem;
	}

	.hero-image img {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 12px;
	}

	.prose {
		width: min(720px, 100%);
		margin: 0 auto;
		font-size: 1.05rem;
		line-height: 1.95;
	}

	.prose :global(h2) {
		margin-top: 3.5rem;
		margin-bottom: 1rem;
		font-size: 1.8rem;
		letter-spacing: -0.02em;
	}

	.prose :global(h3) {
		margin-top: 2.5rem;
		margin-bottom: 0.8rem;
		font-size: 1.35rem;
	}

	.prose :global(p) {
		margin: 1.4rem 0;
	}

	.prose :global(a) {
		text-underline-offset: 3px;
	}

	.prose :global(blockquote) {
		margin: 2rem 0;
		padding: 0.2rem 0 0.2rem 1.2rem;
		border-left: 3px solid currentColor;
		opacity: 0.75;
	}

	.prose :global(code) {
		padding: 0.15rem 0.35rem;
		border-radius: 4px;
		background: rgba(128, 128, 128, 0.12);
		font-family: monospace;
		font-size: 0.9em;
	}

	.prose :global(pre) {
		overflow-x: auto;
		margin: 2rem 0;
		padding: 1.2rem;
		border-radius: 10px;
	}

	.prose :global(pre code) {
		padding: 0;
		background: transparent;
	}

	.prose :global(img) {
		display: block;
		max-width: 100%;
		height: auto;
		margin: 2rem auto;
		border-radius: 10px;
	}

	.prose :global(ul),
	.prose :global(ol) {
		padding-left: 1.4rem;
	}

	.prose :global(li) {
		margin: 0.5rem 0;
	}

	.back {
		width: min(720px, 100%);
		margin: 5rem auto 0;
		padding-top: 2rem;
		border-top: 1px solid rgba(128, 128, 128, 0.2);
		font-family: monospace;
		font-size: 0.85rem;
	}

	.back a {
		color: inherit;
		text-decoration: none;
		opacity: 0.6;
	}

	.back a:hover {
		opacity: 1;
	}

	@media (max-width: 600px) {
		main {
			padding-top: 3rem;
		}

		.article-header {
			margin-bottom: 2rem;
		}

		.hero-image {
			margin: 2rem 0 3rem;
		}

		.prose {
			font-size: 1rem;
			line-height: 1.9;
		}
	}
</style>