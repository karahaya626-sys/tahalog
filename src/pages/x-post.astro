---
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatDate, getPostUrl, getPublishedPosts, type BlogPost } from '../lib/posts';

const SITE_URL = 'https://tahalog.com';
const recentPosts = (await getPublishedPosts()).slice(0, 12);

const introText = `🎮 Xもはじめました！\n\nSteamで「これ面白そう！」ってなったインディーゲームを中心に、体験版・新作・アップデート情報なんかをtaha.log()にまとめています。\n\n日本語情報がまだ少ないゲームを掘るのが好き。気になる作品があったら一緒に追いかけたい！`;
const introHashtags = ['Steam', 'インディーゲーム'];

const categoryHashtags: Record<string, string[]> = {
  Games: ['Steam', 'インディーゲーム'],
  House: ['家づくり'],
  Gadgets: ['ガジェット'],
  AI: ['AI'],
  Dev: ['個人開発'],
};

const articleKeyPoints: Record<string, string> = {
  'astro-cloudflare-pages-blog-build-log': 'Astro＋Cloudflare Pagesでブログを作るまでの流れと、実際に詰まったポイントをまとめた。',
  'ball-x-pit-overview': '60種類以上のボール融合と拠点建築を組み合わせた、Steamで「圧倒的に好評」のローグライト。',
  'demon-lord-just-a-block-overview': '自分が動くと敵も動く半ターン制。Steamでは約1,900件・96％好評。',
  'echoes-of-mystralia-overview': 'Memoryを組み合わせて魔法そのものを自作。8月11日に早期アクセス開始予定。',
  'emberward-first-impressions': 'テトリスのようなブロックで迷路を作るローグライトTD。約10時間遊んだ感想。',
  'factomancer-demo-play-report': '工場は日ごとにリセットされず、前日までの生産ラインへ継ぎ足しながら育てていく。',
  'factomancer-official-overview': '工場建設にランダムイベント、呪文、レリックを組み合わせたローグライト。',
  'guildrun-overview': '戦闘は自動、編成と育成が主役。PvEに特化したローグライク・オートバトラー。',
  'guns-and-dragons-beginner-weapon-crafting': '上位武器を狙うならルーンの使い方が重要。武器作成の流れを整理。',
  'guns-and-dragons-playtest-impressions': 'Gunfire Reborn寄りのローグライトFPS。プレイテストを実際に遊んだ感想。',
  'hello-tahalog': 'taha.log()を始めたときの最初の記録。',
  'house-reasons': '平屋やコンパクトな間取りなど、家づくりで「なぜそうしたか」を記録。',
  'kubb-overview': '65種類のブロックに災害・異次元まで加わる、落ち物パズル×デッキ構築ローグライト。',
  'laundry-room-circulight-mega-r': '2帖のランドリールームでサーキュライトを選んだ理由とモデル比較をまとめた。',
  'lazy-witchs-factory-overview': '30分で工場を作って借金返済。悪魔との契約で生産ルールまで変わる。',
  'moonbrella-overview': 'ジャンプボタンなし。傘だけで移動するメトロイドヴァニアで、体験版はSteamで98％好評。',
  'moonlighter-free-steam-2026': '8月9日10時までSteamで100％オフ。期限内に入手すれば永久保持。',
  'sir-we-have-an-orc-problem-overview': '数万体のオークを火力で迎え撃つ、周回強化型のタワーディフェンス。',
  'swarmdustry-demo-impressions': 'ベルトや電線ではなく虫が物流と電力を担当。体験版を約1時間プレイ。',
  'vena-overview': '六角形タイルをつないで資源網を作る、ボードゲーム感のある自動化ローグライク。',
  'wanderburg-beginner-guide': '序盤で迷いやすい操作や強化のポイントを、体験版ベースで整理。',
  'wanderburg-demo-impressions': '大きくて不安定な城を操作する感覚が面白い。体験版を実際に遊んだ感想。',
  'wanderburg-overview': '車輪付きの城で村や要塞を取り込み、兵器を増やしながら巨大化していく。',
};

function buildArticleText(post: BlogPost): string {
  const postId = post.id.replace(/\.(md|mdx)$/, '');
  const keyPoint = articleKeyPoints[postId];

  return keyPoint
    ? `${post.data.title}\n\n${keyPoint}`
    : post.data.title;
}

function buildIntent(text: string, url: string, hashtags: string[]): string {
  const params = new URLSearchParams({ text, url });
  if (hashtags.length > 0) params.set('hashtags', hashtags.join(','));
  return `https://x.com/intent/tweet?${params.toString()}`;
}

function buildCopyText(text: string, url: string, hashtags: string[]): string {
  const hashtagText = hashtags.map((tag) => `#${tag}`).join(' ');
  return [text, url, hashtagText].filter(Boolean).join('\n\n');
}

const introIntent = buildIntent(introText, `${SITE_URL}/`, introHashtags);
const introCopyText = buildCopyText(introText, `${SITE_URL}/`, introHashtags);
---

<BaseLayout
  title="X投稿アシスト | taha.log()"
  description="taha.log()の記事をXへ投稿するための管理用ページ。"
  seo={{ noindex: true }}
>
  <section class="x-helper page-shell">
    <header class="x-helper__header">
      <p class="eyebrow">// PRIVATE TOOL</p>
      <h1>X投稿アシスト</h1>
    </header>

    <section class="post-section" aria-labelledby="intro-post-title">
      <div class="section-heading">
        <div>
          <p class="eyebrow">// FIRST POST</p>
          <h2 id="intro-post-title">サイト紹介ポスト</h2>
        </div>
        <span class="status">固定用</span>
      </div>

      <article class="post-card">
        <pre>{introCopyText}</pre>
        <div class="post-card__actions">
          <a class="primary-action" href={introIntent} target="_blank" rel="noopener noreferrer">Xで投稿 →</a>
          <button type="button" data-copy-post={introCopyText}>投稿文をコピー</button>
        </div>
      </article>
    </section>

    <section class="post-section" aria-labelledby="article-posts-title">
      <div class="section-heading">
        <div>
          <p class="eyebrow">// RECENT ARTICLES</p>
          <h2 id="article-posts-title">最近の記事</h2>
        </div>
        <span class="status">{recentPosts.length}件</span>
      </div>

      <div class="article-posts">
        {
          recentPosts.map((post) => {
            const text = buildArticleText(post);
            const url = `${SITE_URL}${getPostUrl(post)}`;
            const hashtags = categoryHashtags[post.data.category] ?? [];
            const intent = buildIntent(text, url, hashtags);
            const copyText = buildCopyText(text, url, hashtags);

            return (
              <article class="article-post-card">
                <div class="article-post-card__meta">
                  <span>{post.data.category}</span>
                  <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
                </div>
                <h3>{post.data.title}</h3>
                <pre>{copyText}</pre>
                <div class="post-card__actions">
                  <a class="primary-action" href={intent} target="_blank" rel="noopener noreferrer">Xで投稿 →</a>
                  <button type="button" data-copy-post={copyText}>投稿文をコピー</button>
                  <a class="sub-action" href={getPostUrl(post)} target="_blank" rel="noopener noreferrer">記事を確認</a>
                </div>
              </article>
            );
          })
        }
      </div>
    </section>
  </section>
</BaseLayout>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy-post]').forEach((button) => {
    button.addEventListener('click', async () => {
      const text = button.dataset.copyPost;
      if (!text) return;

      try {
        await navigator.clipboard.writeText(text);
        const original = button.textContent;
        button.textContent = 'コピーした！';
        window.setTimeout(() => {
          button.textContent = original;
        }, 1400);
      } catch {
        button.textContent = 'コピーできませんでした';
      }
    });
  });
</script>

<style>
  .x-helper {
    width: min(920px, calc(100% - 2rem));
    padding-block: clamp(4rem, 8vw, 7rem);
  }

  .x-helper__header {
    margin-bottom: 4rem;
  }

  .eyebrow {
    margin: 0 0 0.55rem;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  h1 {
    margin: 0;
    color: var(--ink);
    font-size: clamp(2.3rem, 6vw, 4rem);
    letter-spacing: -0.055em;
  }

  .post-section + .post-section {
    margin-top: 4.5rem;
  }

  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.25rem;
    padding-bottom: 0.8rem;
    border-bottom: 1px solid var(--line-strong);
  }

  .section-heading h2 {
    margin: 0;
    color: var(--ink);
    font-size: clamp(1.45rem, 3vw, 1.9rem);
  }

  .status {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.68rem;
  }

  .post-card,
  .article-post-card {
    padding: clamp(1.1rem, 3vw, 1.5rem);
    border: 1px solid var(--line-strong);
    background: rgba(251, 247, 237, 0.72);
    box-shadow: 0 12px 32px rgba(48, 39, 24, 0.07);
  }

  .article-posts {
    display: grid;
    gap: 1rem;
  }

  .article-post-card__meta {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.66rem;
  }

  .article-post-card__meta span {
    color: var(--accent);
    font-weight: 700;
  }

  .article-post-card h3 {
    margin: 0.7rem 0 1rem;
    color: var(--ink);
    font-size: 1.08rem;
    line-height: 1.55;
  }

  pre {
    overflow-x: auto;
    margin: 0;
    padding: 1rem;
    border: 1px dashed var(--line-strong);
    background: rgba(255, 255, 255, 0.42);
    color: var(--ink-soft);
    font-family: inherit;
    font-size: 0.88rem;
    line-height: 1.75;
    white-space: pre-wrap;
    word-break: break-word;
  }

  .post-card__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.7rem;
    margin-top: 1rem;
  }

  .post-card__actions a,
  .post-card__actions button {
    min-height: 2.6rem;
    padding: 0.65rem 0.9rem;
    border: 1px solid var(--line-strong);
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-size: 0.78rem;
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
  }

  .post-card__actions .primary-action {
    border-color: var(--ink);
    background: var(--ink);
    color: var(--paper-light);
  }

  .post-card__actions a:hover,
  .post-card__actions button:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .post-card__actions .primary-action:hover {
    border-color: var(--accent);
    background: var(--accent);
    color: white;
  }

  .post-card__actions .sub-action {
    margin-left: auto;
    border-color: transparent;
    color: var(--muted);
  }

  @media (max-width: 600px) {
    .section-heading {
      align-items: start;
    }

    .post-card__actions .sub-action {
      width: 100%;
      margin-left: 0;
      padding-left: 0;
    }
  }
</style>
