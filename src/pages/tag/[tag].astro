---
import PostCard from '../../components/PostCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  getIndexableTags,
  getPublishedPosts,
  type BlogPost,
} from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const tags = getIndexableTags(posts);

  return [...tags].map((tag) => ({
    params: { tag },
    props: {
      tag,
      posts: posts.filter((post) => post.data.tags.includes(tag)),
    },
  }));
}

interface Props {
  tag: string;
  posts: BlogPost[];
}

const { tag, posts } = Astro.props;
---

<BaseLayout
  title={`#${tag}の記事 | taha.log()`}
  description={`taha.log()の「${tag}」タグが付いた記事一覧です。`}
>
  <section class="archive page-shell">
    <header class="archive__header">
      <p class="back"><a href="/blog/">← すべての記事</a></p>
      <p class="section-kicker">// tag</p>
      <h1 class="section-title">#{tag}</h1>
    </header>

    <div class="post-grid">
      {posts.map((post, index) => <PostCard post={post} index={index} />)}
    </div>
  </section>
</BaseLayout>

<style>
  .archive {
    padding-block: clamp(4rem, 8vw, 7rem) 2rem;
  }

  .archive__header {
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--line-strong);
  }

  .back {
    margin: 0 0 2.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .back a {
    color: var(--muted);
    text-decoration: none;
  }

  .back a:hover {
    color: var(--accent);
  }

  .post-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.35rem;
    margin-top: 2rem;
  }

  @media (max-width: 920px) {
    .post-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 650px) {
    .post-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
