---
import PostCard from '../components/PostCard.astro';
import { HOME_PAGE_TITLE, SITE_DESCRIPTION } from '../consts';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublishedPosts } from '../lib/posts';

const allPosts = await getPublishedPosts();
const posts = allPosts.slice(0, 6);
const now = new Date();
const currentYear = now.getFullYear();
const fieldDate = new Intl.DateTimeFormat('ja-JP', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
}).format(now);

const categoryOrder = ['Games', 'AI', 'Dev', 'Gadgets'];
const categories = [...new Set(allPosts.map((post) => post.data.category))]
  .sort((a, b) => {
    const aIndex = categoryOrder.indexOf(a);
    const bIndex = categoryOrder.indexOf(b);
    return (aIndex === -1 ? categoryOrder.length : aIndex) -
      (bIndex === -1 ? categoryOrder.length : bIndex);
  })
  .map((label) => ({ label, href: `/category/${encodeURIComponent(label)}/` }));
---

<BaseLayout title={HOME_PAGE_TITLE} description={SITE_DESCRIPTION}>
  <section class="hero page-shell">
    <div class="hero__main">
      <p class="hero__eyebrow">PERSONAL LOG / {currentYear}</p>

      <h1><span aria-hidden="true">&gt;</span>taha.log()</h1>

      <p class="hero__copy">
        ゲームを中心に、<br />
        気になったことをログに残す。
      </p>

      <p class="hero__description">
        Steamのインディーゲーム、AI、開発、ガジェットなど。<br />
        実際に遊んだこと・試したことを、自分の言葉で記録する個人ブログです。
      </p>

      <a class="hero__cta" href="/blog/">
        <span>記事一覧を見る</span>
        <span class="hero__cta-meta">全{allPosts.length}件 <span aria-hidden="true">→</span></span>
      </a>

      <nav id="categories" class="category-nav" aria-label="カテゴリー">
        {
          categories.map((category, index) => (
            <>
              {index > 0 && <span aria-hidden="true">/</span>}
              <a href={category.href}>{category.label}</a>
            </>
          ))
        }
      </nav>
    </div>

    <aside class="field-note" aria-label="このブログについて">
      <p class="field-note__title">// field note</p>

      <dl>
        <div>
          <dt>date:</dt>
          <dd>{fieldDate}</dd>
        </div>
        <div>
          <dt>location:</dt>
          <dd>home, japan</dd>
        </div>
        <div>
          <dt>focus:</dt>
          <dd>games, ai tools,<br />dev notes</dd>
        </div>
      </dl>

      <span class="field-note__mark" aria-hidden="true">＋</span>
    </aside>
  </section>

  <section id="latest-logs" class="latest page-shell">
    <div class="section-heading">
      <div>
        <p class="section-kicker">// latest logs</p>
        <h2 class="section-title">新しい記録</h2>
      </div>
      <a class="all-logs" href="/blog/">
        <span>記事一覧を見る</span>
        <span aria-hidden="true">→</span>
      </a>
    </div>

    {
      posts.length > 0 ? (
        <div class="post-grid">
          {posts.map((post, index) => <PostCard post={post} index={index} />)}
        </div>
      ) : (
        <p>公開中の記事はまだありません。</p>
      )
    }
  </section>

  <section class="about-note page-shell">
    <p class="about-note__number" aria-hidden="true">LOG / 001</p>
    <div>
      <p class="section-kicker">// about this log</p>
      <h2>遊んだこと、作ったこと、<br />迷ったことまで残していく。</h2>
    </div>
    <div class="about-note__copy">
      <p>
        管理人の「たは」です。SEとして働きながら、Steamのインディーゲームを中心に、AIやWeb開発で試したことを記録しています。
      </p>
      <a href="/about/">プロフィールを見る <span aria-hidden="true">→</span></a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(220px, 270px);
    gap: clamp(3rem, 8vw, 7rem);
    padding-block: clamp(3rem, 6vw, 5.5rem) clamp(3.25rem, 7vw, 5rem);
  }

  .hero::before,
  .hero::after {
    position: absolute;
    left: -0.2rem;
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 1.4rem;
    font-weight: 300;
    content: "+";
    opacity: 0.55;
  }

  .hero::before {
    top: 3.5rem;
  }

  .hero::after {
    bottom: 4.8rem;
  }

  .hero__main {
    position: relative;
    padding-left: clamp(1rem, 5vw, 4.5rem);
  }

  .hero__main::before {
    position: absolute;
    top: -1.4rem;
    bottom: 0;
    left: 0;
    width: 3rem;
    background-image: radial-gradient(var(--line) 0.7px, transparent 0.7px);
    background-size: 8px 8px;
    content: "";
    opacity: 0.65;
  }

  .hero__eyebrow {
    position: relative;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  h1 {
    position: relative;
    margin: 1.2rem 0 1.3rem;
    font-family: var(--font-mono);
    font-size: clamp(3.45rem, 8vw, 7.2rem);
    line-height: 0.95;
    letter-spacing: -0.09em;
  }

  h1 span {
    margin-right: 0.08em;
    color: var(--accent);
  }

  .hero__copy {
    margin: 0;
    font-size: clamp(1.25rem, 2.25vw, 1.75rem);
    font-weight: 700;
    line-height: 1.7;
    letter-spacing: 0.04em;
  }

  .hero__description {
    max-width: 44rem;
    margin: 1.3rem 0 0;
    color: var(--ink-soft);
    font-size: 0.95rem;
    line-height: 1.95;
  }

  .hero__cta {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    min-width: min(100%, 23rem);
    margin-top: 2.1rem;
    padding: 1rem 1.2rem;
    border: 1px solid var(--accent);
    color: var(--accent);
    font-family: var(--font-mono);
    font-weight: 700;
    text-decoration: none;
    transition:
      background-color 160ms ease,
      color 160ms ease;
  }

  .hero__cta:hover {
    background: var(--accent);
    color: var(--paper-light);
  }

  .hero__cta-meta {
    margin-left: 1.5rem;
    font-size: 0.72rem;
    letter-spacing: 0.02em;
  }

  .category-nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-top: 2.7rem;
    font-family: var(--font-mono);
    font-size: clamp(0.8rem, 1.7vw, 1rem);
  }

  .category-nav a {
    text-decoration: none;
  }

  .category-nav a:hover {
    color: var(--accent);
  }

  .category-nav span {
    color: var(--accent);
  }

  .field-note {
    position: relative;
    align-self: center;
    padding-left: 1.6rem;
    border-left: 1px dashed var(--line);
    font-family: var(--font-mono);
  }

  .field-note__title {
    margin: 0;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid var(--line);
    color: var(--accent);
    font-size: 0.75rem;
  }

  dl {
    margin: 0;
  }

  dl div {
    padding: 1rem 0;
    border-bottom: 1px solid var(--line);
  }

  dt,
  dd {
    margin: 0;
    font-size: 0.72rem;
    line-height: 1.7;
  }

  dt {
    color: var(--muted);
  }

  dd {
    margin-top: 0.25rem;
  }

  .field-note__mark {
    position: absolute;
    right: -0.55rem;
    bottom: -0.65rem;
    color: var(--accent);
    font-size: 1.25rem;
  }

  .latest {
    padding-block: 0 4rem;
  }

  .section-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    padding-top: 2.4rem;
    border-top: 1px solid var(--line-strong);
    gap: 2rem;
  }

  .all-logs {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 0.7rem;
    padding: 0.72rem 0.9rem;
    border: 1px solid var(--accent);
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
    text-decoration: none;
    transition:
      background-color 160ms ease,
      color 160ms ease;
  }

  .all-logs span:last-child {
    transition: transform 160ms ease;
  }

  .all-logs:hover {
    background: var(--accent);
    color: var(--paper-light);
  }

  .all-logs:hover span:last-child {
    transform: translateX(4px);
  }

  .post-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.35rem;
    margin-top: 2rem;
  }

  .about-note {
    position: relative;
    display: grid;
    grid-template-columns: 0.3fr 1.15fr 1fr;
    align-items: start;
    gap: clamp(1.5rem, 4vw, 4rem);
    margin-top: 4rem;
    padding-block: 3rem;
    border-top: 1px solid var(--line-strong);
    border-bottom: 1px solid var(--line-strong);
  }

  .about-note__number {
    margin: 0;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
  }

  .about-note h2 {
    margin: 0.7rem 0 0;
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    line-height: 1.55;
    letter-spacing: -0.03em;
  }

  .about-note__copy p {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.95rem;
    line-height: 1.95;
  }

  .about-note__copy a {
    display: inline-flex;
    gap: 0.55rem;
    margin-top: 1.3rem;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
    text-decoration: none;
  }

  @media (max-width: 920px) {
    .hero {
      grid-template-columns: minmax(0, 1fr) 210px;
      gap: 2.5rem;
    }

    .post-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .about-note {
      grid-template-columns: 1fr 1fr;
    }

    .about-note__number {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 700px) {
    .hero {
      display: block;
      padding-block: 3rem 3.75rem;
    }

    .hero__main {
      padding-left: 1rem;
    }

    .hero__main::before {
      width: 1.35rem;
      transform: translateX(-0.7rem);
    }

    .hero__description br {
      display: none;
    }

    .field-note {
      display: none;
    }

    .section-heading {
      align-items: center;
      gap: 1.25rem;
    }

    .all-logs {
      padding-inline: 0.75rem;
      font-size: 0.72rem;
    }

    .post-grid {
      grid-template-columns: 1fr;
    }

    .about-note {
      grid-template-columns: 1fr;
      margin-top: 2rem;
    }

    .about-note__number {
      grid-column: auto;
    }
  }

  @media (max-width: 430px) {
    h1 {
      font-size: clamp(2.45rem, 12vw, 3.4rem);
      letter-spacing: -0.11em;
    }

    .hero__copy br {
      display: none;
    }

    .hero__cta {
      width: 100%;
    }

    .section-heading {
      align-items: stretch;
      flex-direction: column;
      gap: 1rem;
    }

    .all-logs {
      justify-content: space-between;
      width: 100%;
    }
  }
</style>
