---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 5);
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>

	<body>
		<Header />

		<main>
			<section class="hero">
				<p class="prompt">&gt; taha.log()</p>

				<h1>
					ゲームを中心に、<br />
					気になったことをログに残す。 
				</h1>

				<p class="description">
					Steam、インディーゲーム、AI、開発、ガジェットなど。<br />
					管理人「たは」が気になったことを自由に記録する個人ブログです。
				</p>

				<div class="categories">
					<a href="/category/games">Games</a>
					<a href="/category/ai">AI</a>
					<a href="/category/dev">Dev</a>
					<a href="/category/gadgets">Gadgets</a>
				</div>
			</section>

			<section class="latest">
				<div class="latest-header">
					<p class="section-label">// latest logs</p>

					<a href="/blog/" class="view-all">
						all logs →
					</a>
				</div>

				<div class="post-list">
					{
						posts.map((post) => (
							<a class="post" href={`/blog/${post.id}/`}>
								<div class="meta">
									<span class="date">
										<FormattedDate date={post.data.pubDate} />
									</span>

									<span class="category">
										{post.data.category}
									</span>
								</div>

								<h2>{post.data.title}</h2>

								<p>{post.data.description}</p>

								{
									post.data.tags.length > 0 && (
										<div class="tags">
											{post.data.tags.map((tag) => (
												<span>#{tag}</span>
											))}
										</div>
									)
								}

								<span class="read-more">read →</span>
							</a>
						))
					}
				</div>
			</section>
		</main>

		<Footer />
	</body>
</html>

<style>
	main {
		width: min(1040px, calc(100% - 2rem));
		margin: 0 auto;
		padding: 6rem 0;
	}

	.hero {
		padding: 4rem 0 6rem;
	}

	.prompt,
	.section-label {
		margin: 0;
		font-family: monospace;
		font-size: 0.9rem;
		opacity: 0.6;
	}

	h1 {
		max-width: 750px;
		margin: 1rem 0 1.5rem;
		font-size: clamp(2.3rem, 6vw, 4.5rem);
		line-height: 1.15;
		letter-spacing: -0.04em;
	}

	.description {
		max-width: 650px;
		font-size: 1.1rem;
		line-height: 2;
		opacity: 0.75;
	}

	.categories {
		display: flex;
		flex-wrap: wrap;
		gap: 0.7rem;
		margin-top: 2rem;
	}

	.categories a {
		padding: 0.4rem 0.8rem;
		border: 1px solid currentColor;
		border-radius: 999px;
		font-family: monospace;
		font-size: 0.85rem;
		opacity: 0.7;
	}

	.latest {
		border-top: 1px solid rgba(128, 128, 128, 0.25);
		padding-top: 3rem;
	}

	.latest-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
	}

	.view-all {
		color: inherit;
		font-family: monospace;
		font-size: 0.85rem;
		text-decoration: none;
		opacity: 0.55;
	}

	.view-all:hover {
		opacity: 1;
	}

	.post-list {
		margin-top: 2rem;
		border-top: 1px solid rgba(128, 128, 128, 0.2);
	}

	.post {
		display: block;
		padding: 2.5rem 0;
		border-bottom: 1px solid rgba(128, 128, 128, 0.2);
		color: inherit;
		text-decoration: none;
	}

	.meta {
		display: flex;
		align-items: center;
		gap: 0.8rem;
		font-family: monospace;
		font-size: 0.8rem;
	}

	.date {
		opacity: 0.45;
	}

	.category {
		padding: 0.2rem 0.5rem;
		border: 1px solid rgba(128, 128, 128, 0.3);
		border-radius: 999px;
		font-size: 0.75rem;
		opacity: 0.7;
	}

	.post h2 {
		margin: 0.7rem 0 0.8rem;
		font-size: clamp(1.4rem, 4vw, 1.9rem);
		letter-spacing: -0.02em;
	}

	.post p {
		max-width: 650px;
		margin: 0;
		line-height: 1.8;
		opacity: 0.7;
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
		margin-top: 1rem;
		font-family: monospace;
		font-size: 0.8rem;
		opacity: 0.5;
	}

	.read-more {
		display: inline-block;
		margin-top: 1rem;
		font-family: monospace;
		font-size: 0.85rem;
		opacity: 0.65;
		transition: transform 0.2s ease;
	}

	.post:hover .read-more {
		transform: translateX(5px);
	}

	.post:hover h2 {
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 5px;
	}

	@media (max-width: 600px) {
		main {
			padding-top: 2rem;
		}

		.hero {
			padding: 3rem 0 4rem;
		}

		.description br {
			display: none;
		}

		.post {
			padding: 2rem 0;
		}
	}
</style>