---
import PostCard from '../../components/PostCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts } from '../../lib/posts';

const posts = await getPublishedPosts();
---

<BaseLayout
  title="記事一覧 | taha.log()"
  description="ゲーム、AI、Web開発、ガジェットを実体験ベースで記録する個人ブログです。"
>
  <section class="archive page-shell">
    <header class="archive__header">
      <div>
        <p class="section-kicker">// all logs</p>
        <h1 class="section-title">Articles</h1>
      </div>
      <p>ゲーム、AI、開発、ガジェット。<br />実際に遊んだこと・試したことを記録しています。</p>
    </header>

    {
      posts.length > 0 ? (
        <div class="post-grid">
          {posts.map((post, index) => <PostCard post={post} index={index} />)}
        </div>
      ) : (
        <p class="empty">公開中の記事はまだありません。</p>
      )
    }
  </section>
</BaseLayout>

<style>
  .archive {
    padding-block: clamp(4rem, 8vw, 7rem) 2rem;
  }

  .archive__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--line-strong);
    gap: 2rem;
  }

  .archive__header > p {
    max-width: 31rem;
    margin: 0;
    color: var(--ink-soft);
    line-height: 1.8;
  }

  .post-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.35rem;
    margin-top: 2rem;
  }

  .empty {
    margin-top: 2rem;
  }

  @media (max-width: 920px) {
    .post-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 650px) {
    .archive__header {
      align-items: flex-start;
      flex-direction: column;
    }

    .post-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
