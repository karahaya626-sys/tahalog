---
import PostCard from '../../components/PostCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts } from '../../lib/posts';

const posts = await getPublishedPosts();
---

<BaseLayout
  title="ブログ | taha.log()"
  description="ゲーム、AI、Web開発、ガジェットを実体験ベースで記録する個人ブログです。"
>
  <section class="page">
    <header class="page__header">
      <p class="eyebrow">TAHA.LOG()</p>
      <h1>Blog</h1>
      <p>ゲーム、AI、開発、ガジェットの試行錯誤を残します。</p>
    </header>

    {
      posts.length > 0 ? (
        <div class="post-grid">
          {posts.map((post) => <PostCard post={post} />)}
        </div>
      ) : (
        <p>公開中の記事はまだありません。</p>
      )
    }
  </section>
</BaseLayout>

<style>
  .page {
    width: min(100% - 2rem, 1040px);
    margin-inline: auto;
    padding-block: 4rem;
  }

  .page__header {
    margin-bottom: 2rem;
  }

  .eyebrow {
    margin: 0;
    color: var(--accent);
    font-family: var(--font-mono);
    font-weight: 800;
    letter-spacing: 0.08em;
  }

  h1 {
    margin: 0.25rem 0 0.5rem;
    font-size: clamp(2.5rem, 8vw, 4.5rem);
    letter-spacing: -0.04em;
  }

  .page__header > p:last-child {
    color: var(--muted);
  }

  .post-grid {
    display: grid;
    gap: 1rem;
  }
</style>
