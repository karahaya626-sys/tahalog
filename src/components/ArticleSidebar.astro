---
import { Image } from 'astro:assets';
import DefaultPostImage from '../assets/about-tahalog-desk.jpg';
import type { BlogPost } from '../lib/posts';
import { formatDate, getPostUrl } from '../lib/posts';
import RakutenMotionWidget from './RakutenMotionWidget.astro';

interface Props {
  currentPost: BlogPost;
  posts: BlogPost[];
}

const { currentPost, posts } = Astro.props;
const normalizeTag = (tag: string) => tag.trim().toLocaleLowerCase('ja-JP');
const primaryTag = currentPost.data.tags[0]
  ? normalizeTag(currentPost.data.tags[0])
  : undefined;

const sameTopicPosts = primaryTag
  ? posts
      .filter((post) => {
        if (post.id === currentPost.id || !post.data.tags[0]) {
          return false;
        }

        return normalizeTag(post.data.tags[0]) === primaryTag;
      })
      .slice(0, 4)
  : [];

const sameTopicIds = new Set(sameTopicPosts.map((post) => post.id));
const recentPosts = posts
  .filter(
    (post) => post.id !== currentPost.id && !sameTopicIds.has(post.id),
  )
  .slice(0, 5);

const sameTopicLabel =
  currentPost.data.category === 'Games'
    ? 'このゲームの記事'
    : '同じテーマの記事';

const categoryCounts = posts.reduce((counts, post) => {
  const category = post.data.category;
  counts.set(category, (counts.get(category) ?? 0) + 1);
  return counts;
}, new Map<string, number>());

const preferredCategoryOrder = ['Games', 'House', 'Gadgets', 'AI', 'Dev'];
const categories = [...categoryCounts.entries()].sort(([a], [b]) => {
  const aIndex = preferredCategoryOrder.indexOf(a);
  const bIndex = preferredCategoryOrder.indexOf(b);

  if (aIndex === -1 && bIndex === -1) return a.localeCompare(b, 'ja-JP');
  if (aIndex === -1) return 1;
  if (bIndex === -1) return -1;
  return aIndex - bIndex;
});
---

<aside class="article-sidebar" aria-label="記事ナビゲーション">
  <div class="article-sidebar__inner">
    {
      sameTopicPosts.length > 0 && (
        <section class="sidebar-section">
          <p class="sidebar-section__eyebrow">// same topic</p>
          <h2>{sameTopicLabel}</h2>
          <ul class="sidebar-list">
            {sameTopicPosts.map((sidebarPost) => (
              <li>
                <a href={getPostUrl(sidebarPost)}>
                  <span class="sidebar-list__image">
                    {sidebarPost.data.heroImage ? (
                      <Image
                        src={sidebarPost.data.heroImage}
                        alt=""
                        widths={[144]}
                        sizes="72px"
                        loading="lazy"
                      />
                    ) : sidebarPost.data.ogImage ? (
                      <img
                        src={sidebarPost.data.ogImage}
                        alt=""
                        loading="lazy"
                        referrerpolicy="no-referrer"
                      />
                    ) : (
                      <Image
                        src={DefaultPostImage}
                        alt=""
                        widths={[144]}
                        sizes="72px"
                        loading="lazy"
                      />
                    )}
                  </span>
                  <span class="sidebar-list__body">
                    <strong>{sidebarPost.data.title}</strong>
                    <time datetime={sidebarPost.data.pubDate.toISOString()}>
                      {formatDate(sidebarPost.data.pubDate)}
                    </time>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section class="sidebar-section">
          <p class="sidebar-section__eyebrow">// latest logs</p>
          <h2>最近の記事</h2>
          <ul class="sidebar-list">
            {recentPosts.map((sidebarPost) => (
              <li>
                <a href={getPostUrl(sidebarPost)}>
                  <span class="sidebar-list__image">
                    {sidebarPost.data.heroImage ? (
                      <Image
                        src={sidebarPost.data.heroImage}
                        alt=""
                        widths={[144]}
                        sizes="72px"
                        loading="lazy"
                      />
                    ) : sidebarPost.data.ogImage ? (
                      <img
                        src={sidebarPost.data.ogImage}
                        alt=""
                        loading="lazy"
                        referrerpolicy="no-referrer"
                      />
                    ) : (
                      <Image
                        src={DefaultPostImage}
                        alt=""
                        widths={[144]}
                        sizes="72px"
                        loading="lazy"
                      />
                    )}
                  </span>
                  <span class="sidebar-list__body">
                    <strong>{sidebarPost.data.title}</strong>
                    <time datetime={sidebarPost.data.pubDate.toISOString()}>
                      {formatDate(sidebarPost.data.pubDate)}
                    </time>
                  </span>
                </a>
              </li>
            ))}
          </ul>
          <a class="sidebar-section__more" href="/blog/">すべての記事を見る →</a>
        </section>
      )
    }

    {
      categories.length > 0 && (
        <section class="sidebar-section sidebar-section--compact sidebar-extra">
          <p class="sidebar-section__eyebrow">// categories</p>
          <h2>カテゴリ</h2>
          <ul class="category-list">
            {categories.map(([category, count]) => (
              <li>
                <a
                  href={`/category/${category}/`}
                  aria-current={category === currentPost.data.category ? 'page' : undefined}
                >
                  <span>{category}</span>
                  <span class="category-list__count">{count}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section class="sidebar-section sidebar-about sidebar-extra">
      <p class="sidebar-section__eyebrow">// about this log</p>
      <h2>taha.log()</h2>
      <p>
        Steamのインディーゲームを中心に、家づくりやガジェットなど、実際に気になって調べたことをログに残している。
      </p>
      <a class="sidebar-section__more" href="/about/">このブログについて →</a>
    </section>

    <RakutenMotionWidget variant="sidebar" />

    <section class="sidebar-section sidebar-toc" data-article-toc hidden>
      <p class="sidebar-section__eyebrow">// contents</p>
      <h2>目次</h2>
      <nav aria-label="この記事の目次">
        <ol class="toc-list" data-article-toc-list></ol>
      </nav>
    </section>
  </div>
</aside>

<script is:inline>
  (() => {
    const toc = document.querySelector('[data-article-toc]');
    const tocList = document.querySelector('[data-article-toc-list]');
    const headings = Array.from(document.querySelectorAll('.prose h2'));

    if (!toc || !tocList || headings.length < 2) return;

    headings.forEach((heading, index) => {
      if (!heading.id) heading.id = `section-${index + 1}`;

      const item = document.createElement('li');
      const link = document.createElement('a');
      const label = heading.textContent?.trim() || `セクション ${index + 1}`;
      link.href = `#${heading.id}`;
      link.textContent = label;
      link.title = label;
      item.appendChild(link);
      tocList.appendChild(item);
    });

    toc.hidden = false;
  })();
</script>

<style>
  .article-sidebar {
    min-width: 0;
    align-self: stretch;
  }

  .article-sidebar__inner {
    display: grid;
    height: 100%;
    align-content: start;
    gap: 2.2rem;
  }

  .sidebar-section {
    padding: 1rem;
    border: 1px solid var(--line-strong);
    background: rgba(251, 247, 237, 0.72);
    box-shadow: 0 12px 32px rgba(48, 39, 24, 0.07);
  }

  .sidebar-section--compact {
    padding-bottom: 0.85rem;
  }

  .sidebar-section__eyebrow {
    margin: 0 0 0.25rem;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  h2 {
    margin: 0 0 0.9rem;
    color: var(--ink);
    font-size: 1.08rem;
    line-height: 1.45;
  }

  .sidebar-list {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .sidebar-list li + li {
    border-top: 1px solid var(--line);
  }

  .sidebar-list a {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr);
    gap: 0.75rem;
    align-items: center;
    padding-block: 0.85rem;
    color: inherit;
    text-decoration: none;
  }

  .sidebar-list__image {
    overflow: hidden;
    aspect-ratio: 3 / 2;
    border: 1px solid var(--line);
    background: var(--paper-light);
  }

  .sidebar-list__image :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 180ms ease;
  }

  .sidebar-list__body {
    display: grid;
    gap: 0.35rem;
    min-width: 0;
  }

  .sidebar-list strong {
    display: -webkit-box;
    overflow: hidden;
    color: var(--ink);
    font-size: 0.78rem;
    line-height: 1.55;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  .sidebar-list time {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.61rem;
  }

  .sidebar-list a:hover strong {
    color: var(--accent);
  }

  .sidebar-list a:hover .sidebar-list__image :global(img) {
    transform: scale(1.04);
  }

  .sidebar-section__more {
    display: inline-block;
    margin-top: 0.8rem;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    text-decoration: none;
  }

  .sidebar-section__more:hover {
    color: var(--accent);
  }

  .category-list {
    display: grid;
    gap: 0.35rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .category-list a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.8rem;
    padding: 0.55rem 0.65rem;
    border: 1px solid transparent;
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    text-decoration: none;
  }

  .category-list a:hover,
  .category-list a[aria-current='page'] {
    border-color: var(--line);
    background: rgba(221, 92, 62, 0.06);
    color: var(--accent);
  }

  .category-list__count {
    min-width: 1.7rem;
    padding: 0.1rem 0.35rem;
    border-radius: 999px;
    background: rgba(18, 35, 61, 0.06);
    color: var(--muted);
    font-size: 0.62rem;
    text-align: center;
  }

  .sidebar-about p:not(.sidebar-section__eyebrow) {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.78rem;
    line-height: 1.8;
  }

  .sidebar-toc {
    position: sticky;
    top: 6rem;
    overflow-y: auto;
    max-height: calc(100vh - 7rem);
    padding: 0.9rem;
  }

  .sidebar-toc h2 {
    margin-bottom: 0.55rem;
    font-size: 0.98rem;
  }

  .toc-list {
    display: grid;
    gap: 0.22rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  :global(.toc-list li) {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  :global(.toc-list a) {
    display: -webkit-box;
    overflow: hidden;
    padding: 0.55rem 0.65rem;
    border-left: 2px solid transparent;
    background: rgba(255, 255, 255, 0.18);
    color: var(--ink-soft);
    font-size: 0.76rem;
    line-height: 1.6;
    text-decoration: none;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  :global(.toc-list a:hover),
  :global(.toc-list a:focus-visible) {
    border-left-color: var(--accent);
    background: rgba(221, 92, 62, 0.07);
    color: var(--ink);
  }

  :global(.prose h2[id]) {
    scroll-margin-top: 6rem;
  }

  @media (max-width: 1040px) {
    .article-sidebar {
      align-self: auto;
    }

    .article-sidebar__inner {
      height: auto;
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
      margin-top: 1.5rem;
    }

    .sidebar-extra,
    .sidebar-toc {
      display: none;
    }
  }
</style>
