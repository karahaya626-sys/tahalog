---
const today = new Date();
---

<footer>
	<div class="footer-inner">
		<p>&copy; {today.getFullYear()} taha.log()</p>
		<p class="sub">games / ai / dev / whatever.</p>
	</div>
</footer>

<style>
	footer {
		border-top: 1px solid rgba(128, 128, 128, 0.18);
		margin-top: 6rem;
	}

	.footer-inner {
		width: min(900px, calc(100% - 2rem));
		margin: 0 auto;
		padding: 2.5rem 0 4rem;
		text-align: center;
		font-family: monospace;
	}

	p {
		margin: 0;
	}

	.sub {
		margin-top: 0.5rem;
		font-size: 0.8rem;
		opacity: 0.45;
	}
</style>