---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<a class="logo" href="/">
			<span class="prompt">&gt;</span>
			{SITE_TITLE}
		</a>

		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</div>
	</nav>
</header>

<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: #101112;
		border-bottom: 1px solid #303236;
		box-shadow: none;
	}

	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;

		width: min(1040px, calc(100% - 2rem));
		height: 72px;
		margin: 0 auto;
	}

	.logo {
		display: flex;
		align-items: center;
		gap: 0.35rem;

		color: #f2f2ef;
		font-family: monospace;
		font-size: 1.15rem;
		font-weight: 700;
		text-decoration: none;
	}

	.logo:hover {
		color: #ffffff;
	}

	.prompt {
		color: #ff8a63;
		opacity: 0.8;
	}

	.internal-links {
		display: flex;
		align-items: center;
		gap: 0.25rem;
	}

	.internal-links :global(a) {
		padding: 0.6rem 0.75rem;

		color: #d8d8d5;
		font-family: monospace;
		font-size: 0.9rem;
		text-decoration: none;

		border-radius: 6px;
		transition:
			color 150ms ease,
			background-color 150ms ease;
	}

	.internal-links :global(a:hover) {
		color: #ffffff;
		background: rgba(255, 255, 255, 0.08);
	}

	.internal-links :global(a.active) {
		color: #ff8a63;
		font-weight: 700;
		background: rgba(255, 138, 99, 0.12);
	}

	@media (max-width: 600px) {
		header {
			padding: 0 0.5rem;
		}

		nav {
			width: min(1040px, calc(100% - 2rem));
			height: 64px;
		}

		.logo {
			font-size: 1rem;
		}

		.internal-links {
			gap: 0;
		}

		.internal-links :global(a) {
			padding: 0.5rem;
			font-size: 0.8rem;
		}
	}
</style>