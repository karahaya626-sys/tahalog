---
import { SITE_TITLE } from '../consts';

const pathname = Astro.url.pathname;
const isArticles =
  pathname.startsWith('/blog') ||
  pathname.startsWith('/category') ||
  pathname.startsWith('/tag');
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="logo" href="/" aria-label={`${SITE_TITLE} ホーム`}>
      {SITE_TITLE}
    </a>

    <nav aria-label="メインナビゲーション">
      <a
        class:list={['articles-link', { active: isArticles }]}
        href="/blog/"
        aria-current={isArticles ? 'page' : undefined}
      >
        記事一覧
      </a>
      <a href="/#categories">Categories</a>
      <a class:list={{ active: pathname.startsWith('/about') }} href="/about/">
        About
      </a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--line-strong);
    background: rgba(245, 238, 223, 0.86);
    backdrop-filter: blur(12px);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: min(1180px, calc(100% - 3rem));
    min-height: 76px;
    margin-inline: auto;
    gap: 2rem;
  }

  .logo {
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 1.42rem;
    font-weight: 800;
    letter-spacing: -0.04em;
    text-decoration: none;
  }

  nav {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 3vw, 2.8rem);
  }

  nav a {
    position: relative;
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 0.9rem;
    text-decoration: none;
  }

  nav a::after {
    position: absolute;
    right: 0;
    bottom: -0.45rem;
    left: 0;
    height: 1px;
    transform: scaleX(0);
    transform-origin: left;
    background: var(--accent);
    content: "";
    transition: transform 160ms ease;
  }

  nav a:hover::after,
  nav a.active::after {
    transform: scaleX(1);
  }

  nav a.active {
    color: var(--accent);
  }

  nav .articles-link {
    padding: 0.55rem 0.8rem;
    border: 1px solid var(--accent);
    color: var(--accent);
    font-weight: 700;
    transition:
      background-color 160ms ease,
      color 160ms ease;
  }

  nav .articles-link::after {
    display: none;
  }

  nav .articles-link:hover,
  nav .articles-link.active {
    background: var(--accent);
    color: var(--paper-light);
  }

  @media (max-width: 720px) {
    .site-header__inner {
      width: min(100% - 2rem, 1180px);
      min-height: 66px;
      gap: 0.75rem;
    }

    .logo {
      font-size: 1.08rem;
    }

    nav {
      gap: 0.8rem;
    }

    nav a {
      font-size: 0.7rem;
    }

    nav .articles-link {
      padding: 0.48rem 0.62rem;
    }
  }

  @media (max-width: 390px) {
    nav a:nth-child(2) {
      display: none;
    }
  }
</style>
